POSTGRES_DB=norvia
POSTGRES_USER=norvia
POSTGRES_PASSWORD=replace-with-a-local-secret
DATABASE_URL=postgresql+asyncpg://norvia:replace-with-a-local-secret@postgres:5432/norvia
REDIS_URL=redis://localhost:6379/0
MAX_UPLOAD_SIZE_BYTES=10485760
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4317
APP_ENV=development
USER_RATE_LIMIT_PER_MINUTE=5
USER_RATE_BURST=2
GLOBAL_RATE_LIMIT_PER_MINUTE=20
CONTEXT_WINDOW_TOKENS=32768
OTEL_SERVICE_NAME=norvia-backend
